# Configuração do banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Dashboard de Gestão de Incidentes em CX
DB_USER=postgres
DB_PASSWORD=postgres

# Porta em que a API vai rodar
PORT=3001

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório em produção)
JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRES_IN=8h
